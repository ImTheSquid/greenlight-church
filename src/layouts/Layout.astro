---
import { Font } from "astro:assets"
import { ClientRouter } from "astro:transitions"

const title = "Green Light"
const description =
	"Green Light is a multi-genre radio show based in San Francisco."
const image = "/opengraph-image.png"
---

<!doctype html>
<html lang="en">
    <head>
      <ClientRouter />
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link
            rel="icon"
            href="/icon-512.png"
            type="image/png"
            sizes="512x512"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={image} />
        <Font cssVariable="--font-display" preload />
        <script is:inline>
          document.addEventListener("astro:before-swap", (event) => {
            event.newDocument.documentElement.dataset.internalNav = "true"
          });
        </script>
    </head>
    <body>
        <slot />
    </body>
</html>

<style is:global>
    :root {
        --color-canvas: #000000;
        --color-text: #f4f3ef;
        --color-signal-red: #d41720;
        --color-signal-yellow: #dead0d;
        --color-signal-green: #0bc6b9;
        --type-message: clamp(2.75rem, 4.4vw, 4rem);
        --leading-message: 1;
        --tracking-message: -0.035em;
        --type-marquee: clamp(1.55rem, 3vw, 2.75rem);
        --leading-marquee: 1;
        --tracking-marquee: -0.03em;
        --space-page: clamp(1rem, 3vw, 3rem);
        --space-intro-start: clamp(2rem, 7.5vw, 6rem);
        --space-marquee-gap: clamp(1.5rem, 3vw, 3rem);
        --marquee-block-size: clamp(3.5rem, 6vw, 5.5rem);
        --duration-marquee: 24s;
        color-scheme: dark;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        background: var(--color-canvas);
        overflow-x: clip;
        font-synthesis-weight: none;
    }

    body {
        min-inline-size: 0;
        min-block-size: 100%;
        margin: 0;
        background: var(--color-canvas);
        color: var(--color-text);
        font-family: var(--font-display);
    }

    h1, h2, h3, h4 {
      font-weight: 500;
      font-feature-settings:
          "dlig" on,
          "ss02" on,
          "ss05" on,
          "ss06" on,
          "ss08" on,
          "ss09" on;
    }

    .red {
        color: var(--color-signal-red);
    }
    .yellow {
        color: var(--color-signal-yellow);
    }
    .green {
        color: var(--color-signal-green);
    }

    /*
     * iOS Safari leaves an unpainted black band behind the status bar and URL
     * bar after a client-side nav, so the incoming page's site nav and opening
     * text never appear there.
     *
     * The trigger is the root `::view-transition` snapshot. Those pseudo-elements
     * are `position: fixed`, and iOS decides what colour to paint behind the
     * Dynamic Island / URL bar by sampling the top of the viewport — a sample
     * that trips over the pseudo-elements and comes back black. The affected
     * bands then fail to invalidate. See WebKit 320238 and 325199.
     *
     * Measured against device screenshots, to rule out the usual suspects: the
     * page is *not* scrolled (a cross-correlation of a nav'd frame against a
     * fresh load matches at a 0px shift), the black is byte-identical to
     * `--color-canvas` rather than a second system colour, and the damage is
     * top-anchored — everything below the fold matches. The marquee is the only
     * `position: fixed` element in the project and it is `display: none` on the
     * home page, so fixed content is not what causes this.
     *
     * So the root snapshot has to go, not be restyled. The fade is kept by
     * moving it onto <main> via `transition:name` / `transition:animate` — see
     * the page components. The trade is that the canvas and the site nav now
     * cut instantly, and only <main> cross-fades.
     *
     * Note this is *not* about Astro's `mix-blend-mode: plus-lighter` fade.
     * Astro 7 only injects astro/components/viewtransitions.css when a
     * `transition:*` directive is actually used, and until now none was — so
     * the root transition was the browser's own native cross-fade and
     * `plus-lighter` was never in the build. An earlier attempt to override
     * those keyframes was therefore fixing something that did not exist.
     */
    :root {
        view-transition-name: none;
    }
</style>
