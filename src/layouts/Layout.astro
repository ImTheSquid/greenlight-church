---
import { Font } from "astro:assets";

const title = "Green Light";
const description = "Green Light is a multi-genre radio show based in San Francisco.";
const image = "/opengraph-image.png";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link
            rel="icon"
            href="/icon-512.png"
            type="image/png"
            sizes="512x512"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={image} />
        <Font cssVariable="--font-display" preload />
    </head>
    <body>
        <slot />
    </body>
</html>

<style is:global>
    :root {
        --color-canvas: #000000;
        --color-text: #f4f3ef;
        --color-signal-red: #d41720;
        --color-signal-yellow: #dead0d;
        --color-signal-green: #0bc6b9;
        --type-message: clamp(2.75rem, 4.4vw, 4rem);
        --leading-message: 1;
        --tracking-message: -0.035em;
        --type-marquee: clamp(1.55rem, 3vw, 2.75rem);
        --leading-marquee: 1;
        --tracking-marquee: -0.03em;
        --space-page: clamp(1rem, 3vw, 3rem);
        --space-intro-start: clamp(2rem, 7.5vw, 6rem);
        --space-marquee-gap: clamp(1.5rem, 3vw, 3rem);
        --marquee-block-size: clamp(3.5rem, 6vw, 5.5rem);
        --duration-marquee: 24s;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        background: var(--color-canvas);
        overflow-x: clip;
    }

    body {
        min-inline-size: 0;
        min-block-size: 100%;
        margin: 0;
        background: var(--color-canvas);
        color: var(--color-text);
        font-family: var(--font-display);
    }

    .red {
        color: var(--color-signal-red);
    }
    .yellow {
        color: var(--color-signal-yellow);
    }
    .green {
        color: var(--color-signal-green);
    }
</style>
