---
import Layout from "../layouts/Layout.astro";
import AboutNumber from "../components/AboutNumber.astro";
import aboutBlur from "../assets/about/blur.jpg";
import { showDateLabel } from "../lib/datetime";
---

<Layout>
    <main>
        <nav class="site-nav" aria-label="Site">
            <a class="site-nav__link" href="/">
                Home
            </a>
        </nav>
        <div class="split">
            <img
                class="split__image"
                src={aboutBlur.src}
                width={aboutBlur.width}
                height={aboutBlur.height}
                alt=""
            />
            <div class="split__content">
                <h1>
                    What is <strong class="green">Green&nbsp;Light</strong>?
                </h1>
                <div class="prose">
                    <p>
                        <span class="green">Green Light</span> is a multi-genre
                        radio show highlighting DJs, musicians, artists, actors,
                        stand-up comedians, musical theater kids, and circus
                        performers, streaming every 2 weeks.
                    </p>
                    <p>
                        Artists perform their work in front of a small audience
                        of friends in an apartment in San Francisco.
                        Performances are livestreamed & archived on the
                        internet.
                    </p>
                    <p>
                        <span>
                            <a
                                class="link-yellow"
                                href="https://jackhogan.me"
                                target="_blank"
                            >
                                Jack
                            </a>
                        </span>{" "}
                        &{" "}
                        <span>
                            <a
                                class="link-red"
                                href="https://matthewstanciu.com"
                                target="_blank"
                            >
                                Matthew
                            </a>
                        </span>{" "}
                        started it because we want a recurring space to perform
                        live music in a low-stakes & supportive environment, for
                        friends both IRL and remote, and want to hear what
                        others have to share too.
                    </p>
                    <p>Green Light has three guiding principles:</p>
                    <h2 class="green">
                        <AboutNumber number={1} color="green" /> SHOW UP
                    </h2>
                    <p>
                        If you are a creative, this is your time to get your
                        reps in. The next performance is always around the
                        corner, and your friends are looking forward to seeing
                        you, so you have to show up!
                    </p>
                    <p>
                        If you're a professional, this is a great time to
                        practice for your upcoming gigs: a real performance with
                        a real audience, in a low-stakes environment.
                    </p>
                    <p>
                        If your friends are playing, show up and support them!
                    </p>
                    <h2 class="yellow">
                        <AboutNumber number={2} color="yellow" /> PLAY ANYTHING
                    </h2>
                    <p>
                        The audience is here for you & the floor is yours. Do
                        whatever you want: try new things & experiment, or just
                        do whatever makes you feel good—the audience does not
                        expect anything else. If it sucks it doesn't matter
                        because the audience is your friends, and every
                        performance sounds great when your friend is the
                        performer. But it won't suck, you'll do great.
                    </p>
                    <h2 class="red">
                        <AboutNumber number={3} color="red" /> GET A URL
                    </h2>
                    <p>
                        Every performance is livestreamed & archived on the
                        internet. The goal is not necessarily for anyone to
                        watch it; it's just to have a link to your work that you
                        can share and look back on in the future, or not. If
                        people watch it that's great too!
                    </p>
                    <hr />
                    <p>
                        Green Light streams on{" "}
                        <span>
                            <a
                                class="link-green"
                                href="https://www.youtube.com/@GreenLightDotChurch"
                                target="_blank"
                            >
                                YouTube
                            </a>
                        </span>{" "}
                        every other Friday at 9pm PT, next on{" "}
                        <strong class="green">{showDateLabel}</strong>.
                    </p>
                    <p>
                        If we can answer any questions or you want to say hi,
                        email{" "}
                        <span>
                            <a
                                class="link-green"
                                href="mailto:info@greenlight.church"
                            >
                                info@greenlight.church
                            </a>
                        </span>{" "}
                        :)
                    </p>
                </div>
            </div>
        </div>
    </main>
</Layout>

<style>
    .site-nav {
        position: absolute;
        inset-block-start: var(--space-page);
        inset-inline-start: var(--space-page);
        display: flex;
    }

    @media (max-width: 32em) {
        .site-nav {
            position: static;
        }
    }

    .site-nav__link {
        color: var(--color-text);
        transition: color 180ms ease;
        font-size: 0.875rem;
        text-decoration: none;
        text-transform: uppercase;
        text-underline-offset: 0.4em;

        &::before {
            content: "←";
            margin-inline-end: 0.5em;
        }
    }

    .site-nav__link:hover {
        color: var(--color-signal-green);
    }

    .site-nav__link:focus-visible {
        color: var(--color-signal-green);
        outline: 2.5px solid var(--color-signal-green);
        outline-offset: 0.5rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .site-nav__link {
            transition: none;
        }
    }

    main {
        display: flex;
        flex-direction: column;
        gap: var(--space-page);
        inline-size: 100%;
        min-block-size: 100dvh;
        max-inline-size: 72rem;
        margin-inline: auto;
        padding-block: var(--space-intro-start)
            calc(var(--space-intro-start) + 2rem);
        padding-inline: var(--space-page);
    }

    .split {
        display: flex;
        flex-direction: column;
    }

    .split__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-page);
        scrollbar-color: var(--color-signal-red) transparent;
    }

    .split__image {
        inline-size: calc(100% + 2 * var(--space-page));
        margin-inline: calc(-1 * var(--space-page));
        block-size: auto;
        order: 1;
    }

    @media (min-width: 40em) {
        main {
            block-size: 100svh;
            padding-block-end: 0;
            overflow-y: clip;
        }

        .split {
            flex-direction: row;
            align-items: flex-start;
            inline-size: auto;
            margin-inline: 0;
        }

        .split__content {
            flex: 1 1 auto;
            max-inline-size: 42rem;
            block-size: calc(100svh - var(--space-intro-start));
            overflow-y: auto;
            padding-block-end: 3rem;
            padding-inline-end: clamp(2rem, 3vw, 3rem);
        }

        .split__image {
            flex: 0 0 auto;
            inline-size: min(40%, 30rem);
            margin-inline: 0;
            block-size: auto;
        }
    }

    @media (min-width: 48em) {
        .split {
            inline-size: 100vw;
            margin-inline: calc(
                -1 * (var(--space-page) + (100vw - min(72rem, 100vw)) / 2)
            );
        }

        .split__content {
            max-inline-size: none;
            padding-inline-start: var(--space-page);
            padding-inline-end: clamp(2rem, 4vw, 4rem);
        }

        .split__image {
            margin-block-start: calc(-1 * var(--space-intro-start));
            inline-size: auto;
            block-size: 100svh;
        }

        h2 + p,
        h2 + p + p,
        h2 + p + p + p {
            margin-left: 3rem;
        }
    }

    @media (min-width: 48em) and (max-width: 100em) and (min-height: 48.01em) {
        main {
            padding-block-end: 0;
            block-size: 100dvh;
            overflow-y: visible;
        }

        .split {
            flex-direction: column;
            inline-size: 100vw;
            margin-inline: calc(
                -1 * (var(--space-page) + (100vw - min(72rem, 100vw)) / 2)
            );
            flex: 1 1 auto;
            min-block-size: 0;
        }

        .split__content {
            max-inline-size: 42rem;
            padding-inline: var(--space-page);
            block-size: auto;
            overflow-y: visible;
            padding-block-end: 0;
        }

        .split__image {
            position: static;
            inset-block-start: auto;
            inset-inline-end: auto;
            margin-block-start: 0;
            flex: 0 0 auto;
            inline-size: 100%;
            object-fit: cover;
            object-position: center 30%;
            block-size: 500px;
        }
    }

    @media (min-width: 100em) {
        main {
            block-size: auto;
            padding-block-end: calc(var(--space-intro-start) + 2rem);
            overflow-y: visible;
        }

        .split {
            display: block;
            inline-size: auto;
            margin-inline: 0;
        }

        .split__content {
            display: block;
            block-size: auto;
            overflow-y: visible;
            padding-block-end: 0;
            padding-inline-start: 0;
            max-inline-size: none;
        }

        .split__content .prose {
            display: block;
            margin-block-start: var(--space-page);
        }

        .split__content .prose p + p {
            margin-block-start: clamp(1rem, 1.5vw, 1.5rem);
        }

        .split__image {
            float: right;
            margin-block-start: 0;
            margin-block-end: clamp(1rem, 1.5vw, 1.5rem);
            margin-inline: clamp(2rem, 3vw, 3rem) 0;
            inline-size: min(40%, 30rem);
            block-size: auto;
        }
    }

    h1 {
        margin: 0;
        font-size: var(--type-message);
        line-height: var(--leading-message);
        letter-spacing: var(--tracking-message);
        overflow-wrap: break-word;
    }

    h1 strong {
        font-weight: inherit;
    }

    h2 {
        margin: 0;
        display: flex;
        align-items: center;
        gap: clamp(0.6rem, 1vw, 0.85rem);
        font-size: clamp(1.375rem, 2vw, 1.75rem);
        overflow-wrap: break-word;
    }

    .prose {
        display: flex;
        flex-direction: column;
        gap: clamp(1rem, 1.5vw, 1.5rem);
    }

    @media (max-width: 40em) {
        .split {
            gap: calc(3 * var(--space-page));
        }

        .prose {
            margin-top: 1rem;
        }

        main {
            padding-block-end: 0;
        }
    }

    p {
        margin: 0;
        color: var(--color-text);
        font-size: clamp(1rem, 1.25vw, 1.125rem);
        line-height: 1.55;
        letter-spacing: normal;
        text-wrap: pretty;
    }

    a {
        color: var(--link-color, var(--color-signal-green));
        text-decoration: underline;
        text-underline-offset: 0.22em;
        transition: color 180ms ease;
    }

    a:hover {
        color: var(--link-hover, var(--color-signal-yellow));
    }

    a:focus-visible {
        color: var(--link-hover, var(--color-signal-yellow));
        outline: 2.5px solid var(--link-hover, var(--color-signal-yellow));
        outline-offset: 0.5rem;
    }

    hr {
        border: 0;
        margin-inline: 0;
        inline-size: 40%;
        block-size: 2px;
        background: var(--color-signal-yellow);
        margin: 0 auto;
        margin-block: 1rem;
    }

    .link-yellow {
        --link-color: var(--color-signal-yellow);
        --link-hover: var(--color-signal-green);
    }

    .link-red {
        --link-color: var(--color-signal-red);
        --link-hover: var(--color-signal-green);
    }
</style>
