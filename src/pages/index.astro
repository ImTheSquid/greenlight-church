---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import camera from "../assets/home/camera.jpeg";
import floor from "../assets/home/floor.jpeg";
import mff from "../assets/home/mff.jpeg";
import peace from "../assets/home/peace.jpeg";
import sofa from "../assets/home/sofa.jpeg";

const photos = [
    { image: peace, alt: "A peaceful scene" },
    { image: camera, alt: "A camera" },
    { image: floor, alt: "A view of the floor" },
    { image: mff, alt: "Green Light photo" },
    { image: sofa, alt: "A sofa" },
];
---

<Layout>
    <main>
        <p>
            <span class="green">Green Light</span> is a multi-genre radio show based
            in <span class="yellow">San Francisco</span>, CA. It streams every
            two weeks on Friday nights: next on <span class="red">Sept 11</span
            >.
        </p>

        <section class="filmstrip" aria-labelledby="filmstrip-title">
            <div class="filmstrip__scroller" tabindex="0">
                <div class="filmstrip__track">
                    {
                        photos.map(({ image, alt }) => (
                            <figure class="filmstrip__frame">
                                <Image
                                    src={image}
                                    alt={alt}
                                    sizes="(max-width: 640px) 72vw, 28vw"
                                    widths={[480, 720, 960]}
                                    loading="lazy"
                                    decoding="async"
                                />
                            </figure>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>

    <aside class="marquee" aria-hidden="true">
        <div class="marquee__track">
            <div class="marquee__sequence">
                <span class="marquee__label marquee__label--red"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--yellow"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--green"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--red"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--yellow"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--green"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--red"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--yellow"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--green"
                    >PLAY ANYTHING</span
                >
            </div>
            <div class="marquee__sequence">
                <span class="marquee__label marquee__label--red"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--yellow"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--green"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--red"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--yellow"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--green"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--red"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--yellow"
                    >PLAY ANYTHING</span
                >
                <span class="marquee__label marquee__label--green"
                    >PLAY ANYTHING</span
                >
            </div>
        </div>
    </aside>
</Layout>

<style>
    main {
        min-block-size: 100dvh;
        padding-block: var(--space-intro-start)
            calc(var(--marquee-block-size) + var(--space-page));
        padding-inline: var(--space-page);
    }

    p {
        max-inline-size: 24ch;
        margin: 0;
        font-size: var(--type-message);
        font-weight: 500;
        line-height: var(--leading-message);
        letter-spacing: var(--tracking-message);
        overflow-wrap: break-word;
        font-feature-settings:
            "dlig" on,
            "ss02" on,
            "ss05" on,
            "ss06" on,
            "ss08" on,
            "ss09" on;
    }

    .filmstrip {
        margin-block-start: clamp(4rem, 13vw, 10rem);
    }

    .filmstrip h2 {
        margin: 0 0 1rem;
        color: var(--color-signal-yellow);
        font-size: 0.75rem;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .filmstrip__scroller {
        margin-inline: calc(var(--space-page) * -1);
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scrollbar-width: thin;
        scrollbar-color: var(--color-signal-green) transparent;
    }

    .filmstrip__scroller:focus-visible {
        outline: 2px solid var(--color-signal-green);
        outline-offset: 0.5rem;
    }

    .filmstrip__track {
        display: flex;
        gap: clamp(0.75rem, 1.5vw, 1.5rem);
        inline-size: max-content;
        padding-inline: var(--space-page);
    }

    .filmstrip__frame {
        flex: 0 0 clamp(15rem, 28vw, 28rem);
        block-size: clamp(15rem, 32vw, 31rem);
        margin: 0;
        overflow: hidden;
        background: #161616;
    }

    .filmstrip__frame img {
        display: block;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        filter: saturate(0.9);
        transition: filter 180ms ease;
    }

    .filmstrip__frame:hover img,
    .filmstrip__frame:focus-within img {
        filter: saturate(1);
    }

    @media (prefers-reduced-motion: reduce) {
        .filmstrip__frame img {
            transition: none;
        }
    }

    .marquee {
        position: fixed;
        inset-block-end: 0;
        inset-inline: 0;
        display: flex;
        block-size: var(--marquee-block-size);
        align-items: center;
        overflow: hidden;
        background: var(--color-canvas);
        pointer-events: none;
    }

    .marquee__track {
        display: flex;
        inline-size: max-content;
        animation: marquee-left var(--duration-marquee) linear infinite;
        will-change: transform;
    }

    .marquee__sequence {
        display: flex;
        flex: none;
        align-items: center;
        gap: var(--space-marquee-gap);
        padding-inline-end: var(--space-marquee-gap);
    }

    .marquee__label {
        flex: none;
        font-size: var(--type-marquee);
        font-weight: 500;
        line-height: var(--leading-marquee);
        letter-spacing: var(--tracking-marquee);
        white-space: nowrap;
    }

    .marquee__label--red {
        color: var(--color-signal-red);
    }

    .marquee__label--yellow {
        color: var(--color-signal-yellow);
    }

    .marquee__label--green {
        color: var(--color-signal-green);
    }

    @keyframes marquee-left {
        from {
            transform: translate3d(0, 0, 0);
        }

        to {
            transform: translate3d(-50%, 0, 0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee__track {
            animation: none;
            will-change: auto;
        }

        .marquee__sequence:last-child {
            display: none;
        }
    }
</style>
