---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import camera from "../assets/home/camera.jpeg";
import floor from "../assets/home/floor.jpeg";
import mff from "../assets/home/mff.jpeg";
import peace from "../assets/home/peace.jpeg";
import sofa from "../assets/home/sofa.jpeg";

const photos = [
    { image: peace, alt: "A peaceful scene" },
    { image: camera, alt: "A camera" },
    { image: floor, alt: "A view of the floor" },
    { image: mff, alt: "Green Light photo" },
    { image: sofa, alt: "A sofa" },
];

const marqueeColors = ["red", "yellow", "green"];
---

<Layout>
    <main>
        <iframe
            width="560"
            height="315"
            src="https://www.youtube.com/embed/O3aYaF2P20I?si=ZqV55aofQYYbpVhR"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen>
        </iframe>


        <p class="intro-copy">
            <span class="intro-line" style="--line-index: 0">
                <span class="intro-line__text"
                    ><strong class="green">Green Light</strong> is a multi-genre radio</span
                >
            </span>
            <span class="intro-line" style="--line-index: 1">
                <span class="intro-line__text"
                    >show based in <strong class="yellow">San Francisco</strong
                    >, CA.</span
                >
            </span>
            <span class="intro-line" style="--line-index: 2">
                <span class="intro-line__text">It streams every two weeks</span>
            </span>
            <span class="intro-line" style="--line-index: 3">
                <span class="intro-line__text"
                    >on Friday nights: next on <strong class="red"
                        >Sept 11</strong
                    >.</span
                >
            </span>
        </p>

        <section class="filmstrip" aria-labelledby="filmstrip-title">
            <div class="filmstrip__scroller" tabindex="0">
                <div class="filmstrip__track">
                    {
                        photos.map(({ image, alt }) => (
                            <figure class="filmstrip__frame">
                                <Image
                                    src={image}
                                    alt={alt}
                                    sizes="(max-width: 640px) 72vw, 28vw"
                                    widths={[480, 720, 960]}
                                    loading="lazy"
                                    decoding="async"
                                />
                            </figure>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>

    <aside class="marquee" aria-hidden="true">
        <div class="marquee__track">
            {
                Array.from({ length: 2 }, () => (
                    <div class="marquee__sequence">
                        {Array.from({ length: 3 }, () =>
                            marqueeColors.map((color) => (
                                <span class={`marquee__label ${color}`}>
                                    PLAY ANYTHING
                                </span>
                            )),
                        )}
                    </div>
                ))
            }
        </div>
    </aside>
</Layout>

<style>
    main {
        min-block-size: 100dvh;
        padding-block: var(--space-intro-start)
            calc(var(--marquee-block-size) + var(--space-page));
        padding-inline: var(--space-page);
    }

    iframe {
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        margin-block-start: calc(var(--space-page) * -1);
        margin-block-end: calc(var(--space-page) * 3);
    }

    main:has(iframe) + .marquee {
        display: none;
    }

    .intro-copy {
        max-inline-size: 24ch;
        margin: 0;
        font-size: var(--type-message);
        font-weight: 500;
        line-height: var(--leading-message);
        letter-spacing: var(--tracking-message);
        overflow-wrap: break-word;
        font-feature-settings:
            "dlig" on,
            "ss02" on,
            "ss05" on,
            "ss06" on,
            "ss08" on,
            "ss09" on;
    }

    .intro-copy strong {
        white-space: nowrap;
        font-weight: inherit;
    }

    .intro-line {
        display: block;
        overflow: hidden;
        padding-block-end: 0.24em;
        margin-block-end: -0.24em;
    }

    .intro-line__text {
        display: block;
        transform: translateY(105%);
    }

    @media (prefers-reduced-motion: no-preference) {
        .intro-copy.is-revealed .intro-line__text {
            animation: vertical-cut-reveal 700ms cubic-bezier(0.22, 1, 0.36, 1)
                both;
            animation-delay: calc(var(--line-index) * 180ms);
        }
    }

    @keyframes vertical-cut-reveal {
        from {
            transform: translateY(105%);
        }

        to {
            transform: translateY(0);
        }
    }

    .filmstrip {
        margin-block-start: clamp(4rem, 13vw, 10rem);
    }

    .filmstrip h2 {
        margin: 0 0 1rem;
        color: var(--color-signal-yellow);
        font-size: 0.75rem;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .filmstrip__scroller {
        margin-inline: calc(var(--space-page) * -1);
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scroll-padding-inline: var(--space-page);
        scroll-snap-type: inline mandatory;
        scrollbar-width: thin;
        scrollbar-color: var(--color-signal-red) transparent;
    }

    .filmstrip__scroller:focus-visible {
        outline: 2px solid var(--color-signal-green);
        outline-offset: 0.5rem;
    }

    .filmstrip__track {
        display: flex;
        gap: clamp(0.75rem, 1.5vw, 1.5rem);
        inline-size: max-content;
        padding-inline: var(--space-page);
    }

    .filmstrip__frame {
        flex: 0 0 auto;
        block-size: clamp(15rem, 32vw, 31rem);
        margin: 0;
        overflow: hidden;
        scroll-snap-align: start;
        background: #161616;
    }

    .filmstrip__frame img {
        display: block;
        inline-size: auto;
        block-size: 100%;
    }

    @media (prefers-reduced-motion: no-preference) {
        .filmstrip__frame img {
            filter: saturate(0.875);
            transition: filter 180ms ease;
        }

        .filmstrip__frame:hover img,
        .filmstrip__frame:focus-within img {
            filter: saturate(1.1);
        }
    }

    @media (scripting: none) {
        .intro-line__text {
            transform: none;
        }
    }

    .marquee {
        position: fixed;
        inset-block-end: 0;
        inset-inline: 0;
        display: flex;
        block-size: var(--marquee-block-size);
        align-items: center;
        overflow: hidden;
        background: var(--color-canvas);
        pointer-events: none;
    }

    .marquee__track {
        display: flex;
        inline-size: max-content;
        animation: marquee-left var(--duration-marquee) linear infinite;
        will-change: transform;
    }

    .marquee__sequence {
        display: flex;
        flex: none;
        align-items: center;
        justify-content: space-around;
        gap: var(--space-marquee-gap);
        min-inline-size: 100vw;
        padding-inline-end: var(--space-marquee-gap);
    }

    .marquee__label {
        flex: none;
        font-size: var(--type-marquee);
        font-weight: 500;
        line-height: var(--leading-marquee);
        letter-spacing: var(--tracking-marquee);
        white-space: nowrap;
    }

    @keyframes marquee-left {
        from {
            transform: translate3d(0, 0, 0);
        }

        to {
            transform: translate3d(-50%, 0, 0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee__track {
            animation: none;
            will-change: auto;
        }

        .marquee__sequence:last-child {
            display: none;
        }
    }
</style>

<script>
    const introCopy = document.querySelector(".intro-copy");

    if (
        introCopy &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
        requestAnimationFrame(() => introCopy.classList.add("is-revealed"));
    }
</script>
