---
import Layout from "../layouts/Layout.astro"
import Countdown from "../components/Countdown.astro"
import Gallery from "../components/Gallery.astro"
import {
	nextShowDate,
	SHOW_END_OFFSET_MS,
	SHOW_WALL_TIME,
	wallTimeToInstant,
} from "../lib/datetime"
import { getLiveVideo } from "../lib/youtube"
import cancelledDates from "../data/cancelled.json"

export const prerender = false

const marqueeColors = ["red", "yellow", "green"]

const NEXT_SHOW_ANCHOR = "2026-07-31"
const SHOW_START_OFFSET_MS = 30 * 60_000

const now = new Date()
const showDate = nextShowDate(now, NEXT_SHOW_ANCHOR, cancelledDates)

const showDateLabel = new Intl.DateTimeFormat("en-US", {
	month: "long",
	day: "numeric",
	timeZone: "America/Los_Angeles",
}).format(showDate)

const liveVideo = await getLiveVideo()
// TEMPORARY: the embed gate is open for today only (PT), same window shape
// as the Friday gate. Revert to showDate.getTime() once testing is done.
const todayInPT = new Intl.DateTimeFormat("en-CA", {
	timeZone: "America/Los_Angeles",
}).format(now) // YYYY-MM-DD
const windowAnchor = wallTimeToInstant(
	`${todayInPT}T${SHOW_WALL_TIME}`,
	"America/Los_Angeles",
).getTime()
const windowStart = windowAnchor - SHOW_START_OFFSET_MS
const windowEnd = windowAnchor + SHOW_END_OFFSET_MS
const isStreaming =
	liveVideo !== null &&
	windowStart <= now.getTime() &&
	now.getTime() < windowEnd
const embedSrc =
	isStreaming && liveVideo
		? `https://www.youtube.com/embed/${liveVideo.videoId}`
		: null
---

<Layout>
    <main data-next-show-anchor={NEXT_SHOW_ANCHOR}>
      {embedSrc && <iframe
            width="560"
            height="315"
            src={embedSrc}
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen>
        </iframe>}

        <p class="intro-copy">
            <span class="intro-line" style="--line-index: 0">
                <span class="intro-line__text"
                    ><strong class="green">Green Light</strong> is a multi-genre radio</span
                >
            </span>
            <span class="intro-line" style="--line-index: 1">
                <span class="intro-line__text"
                    >show based in <strong class="yellow">San Francisco</strong
                    >, CA,</span
                >
            </span>
            <span class="intro-line" style="--line-index: 2">
                <span class="intro-line__text">streaming every other Friday:</span>
            </span>
            <span class="intro-line" style="--line-index: 3">
                <span class="intro-line__text"
                    >next at 9PM PT on <strong class="red"
                        >{showDateLabel}</strong
                    >.</span
                >
            </span>
        </p>

        <p class="archives-link">
            <a
                class="archives-link__anchor"
                href="https://www.youtube.com/@GreenLightDotChurch"
                target="_blank"
                >Watch on YouTube</a
            >
        </p>

        <Gallery />

        {!isStreaming && <Countdown date={showDate.toISOString()} />}
    </main>

    <aside class="marquee" aria-hidden="true">
        <div class="marquee__track">
            {
                Array.from({ length: 2 }, () => (
                    <div class="marquee__sequence">
                        {Array.from({ length: 3 }, () =>
                            marqueeColors.map((color) => (
                                <span class={`marquee__label ${color}`}>
                                    PLAY ANYTHING
                                </span>
                            )),
                        )}
                    </div>
                ))
            }
        </div>
    </aside>
</Layout>

<style>
    main {
        min-block-size: 100dvh;
        padding-block: var(--space-intro-start)
            calc(var(--marquee-block-size) + var(--space-intro-start));
        padding-inline: var(--space-page);
        display: flex;
        flex-direction: column;
        gap: var(--space-page);
    }

    iframe {
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        margin-block-start: calc(var(--space-page) * -1);
        margin-block-end: calc(var(--space-page) * 3);
    }

    main:has(iframe) + .marquee {
        display: none;
    }

    .intro-copy {
        max-inline-size: 24ch;
        margin: 0;
        font-size: var(--type-message);
        font-weight: 500;
        line-height: var(--leading-message);
        letter-spacing: var(--tracking-message);
        overflow-wrap: break-word;
        font-feature-settings:
            "dlig" on,
            "ss02" on,
            "ss05" on,
            "ss06" on,
            "ss08" on,
            "ss09" on;
    }

    .intro-copy strong {
        white-space: nowrap;
        font-weight: inherit;
    }

    .archives-link {
      display: block;
        margin:  max(2.5rem, var(--space-page)) 0;
        font-size: clamp(1.125rem, 1.5vw, 1.375rem);
        text-transform: uppercase;
    }

    @media (prefers-reduced-motion: no-preference) {
        .archives-link {
            animation: 500ms cubic-bezier(0.22, 1, 0.36, 1) both fade-in;
            animation-delay: calc(5 * 180ms);
        }
    }

    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .archives-link__anchor {
        color: var(--color-text);
        text-underline-offset: 0.4em;
        text-decoration: none;
        padding: 0.75rem 1.25rem 1rem;
        border: 2.5px solid color-mix(in srgb, currentColor 75%, transparent);
        transition: color 180ms ease;

        &::after {
          content: '→';
          margin-inline-start: 0.5em;
        }
    }

    .archives-link__anchor:hover {
        color: var(--color-signal-red);
    }

    .archives-link__anchor:focus-visible {
        outline: 2.5px solid var(--color-signal-green);
        color: var(--color-signal-green);
        outline-offset: 0.5rem;
    }

    .intro-line {
        display: block;
        overflow: hidden;
        padding-block-end: 0.24em;
        margin-block-end: -0.24em;
    }

    .intro-line__text {
        display: block;
        transform: translateY(105%);
    }

    @media (prefers-reduced-motion: no-preference) {
        .intro-copy.is-revealed .intro-line__text {
            animation: vertical-cut-reveal 700ms cubic-bezier(0.22, 1, 0.36, 1)
                both;
            animation-delay: calc(var(--line-index) * 180ms);
        }
    }

    @keyframes vertical-cut-reveal {
        from {
            transform: translateY(105%);
        }

        to {
            transform: translateY(0);
        }
    }

    @media (scripting: none) {
        .intro-line__text {
            transform: none;
        }
    }

    .marquee {
        position: fixed;
        inset-block-end: 0;
        inset-inline: 0;
        display: flex;
        block-size: var(--marquee-block-size);
        align-items: center;
        overflow: hidden;
        background: var(--color-canvas);
        pointer-events: none;
    }

    .marquee__track {
        display: flex;
        inline-size: max-content;
        animation: marquee-left var(--duration-marquee) linear infinite;
        will-change: transform;
    }

    .marquee__sequence {
        display: flex;
        flex: none;
        align-items: center;
        justify-content: space-around;
        gap: var(--space-marquee-gap);
        min-inline-size: 100vw;
        padding-inline-end: var(--space-marquee-gap);
    }

    .marquee__label {
        flex: none;
        font-size: var(--type-marquee);
        font-weight: 500;
        line-height: var(--leading-marquee);
        letter-spacing: var(--tracking-marquee);
        white-space: nowrap;
    }

    @keyframes marquee-left {
        from {
            transform: translate3d(0, 0, 0);
        }

        to {
            transform: translate3d(-50%, 0, 0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .archives-link__anchor {
            transition: none;
        }

        .marquee__track {
            animation: none;
            will-change: auto;
        }

        .marquee__sequence:last-child {
            display: none;
        }
    }
</style>

<script>
    import cancelledDates from "../data/cancelled.json"
    import { nextShowDate } from "../lib/datetime"

    const main = document.querySelector("main")
    const introCopy = document.querySelector(".intro-copy")
    const archivesLink = document.querySelector(".archives-link")
    const showDateLabel = document.querySelector(".intro-line strong.red")
    const countdown = document.querySelector(".countdown")

    const anchor = main?.dataset.nextShowAnchor
    if (anchor && showDateLabel && countdown) {
        const target = nextShowDate(new Date(), anchor, cancelledDates)
        const baked = new Date(countdown.getAttribute("data-date") ?? "").getTime()
        if (!Number.isNaN(baked) && baked !== target.getTime()) {
            showDateLabel.textContent = new Intl.DateTimeFormat("en-US", {
                month: "long",
                day: "numeric",
                timeZone: "America/Los_Angeles",
            }).format(target)
            countdown.setAttribute("data-date", target.toISOString())
        }
    }

    if (
        introCopy &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
        requestAnimationFrame(() => {
            introCopy.classList.add("is-revealed")
            archivesLink.classList.add("is-revealed")
        })
    }
</script>
